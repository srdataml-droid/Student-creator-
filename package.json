{
  "name": "student-learning-platform-engineering-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Campus learning web platform — server-side SQLite development database; Supabase later",
  "scripts": {
    "test": "node --test packages/payment-core/test/*.test.mjs packages/content-core/test/*.test.mjs packages/local-core/test/*.test.mjs apps/web/lib/*.test.mjs",
    "local:admin": "node scripts/local-admin.mjs",
    "local:backup": "node scripts/local-backup.mjs backup",
    "local:verify-backup": "node scripts/local-backup.mjs verify",
    "local:restore": "node scripts/local-backup.mjs restore"
  },
  "engines": {
    "node": ">=22"
  }
}
