# Server configuration template only. Never commit real credentials.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=  # RESERVED: not used for live checkout or deployment
# PAYSTACK_ENVIRONMENT=test
# Optional local-only sandbox checkout: set a real Paystack sk_test key in the
# server's private runtime environment, NEVER in source or NEXT_PUBLIC_*.
# PAYSTACK_TEST_SECRET_KEY=
# Local nonproduction timestamped Paystack-Signature webhook uses a separate whsec_
# signing secret plus whk_ key ID (not the sk_test API key).
# PAYSTACK_WEBHOOK_SIGNING_SECRET=
# PAYSTACK_WEBHOOK_KEY_ID=
# Opt in only when running scripts/local-payment-reconcile.mjs against a disposable DB.
# LOCAL_PAYMENT_SANDBOX=1

# Student platform: server-only Supabase draft API (not connected yet).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use server-side legacy service-role JWT only; NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local-first: no online database or API keys required
APP_DATA_MODE=local
# Optional absolute local SQLite database path, shared by admin CLI and dev server.
# LOCAL_SQLITE_PATH=/your/private/path/campus.sqlite
# Bootstrap admin using secure terminal input: do not commit these secrets.
# LOCAL_ADMIN_EMAIL=
# LOCAL_ADMIN_PASSWORD=
# One-person alpha (local SQLite only, no public/serverless deployment).
# Set ALL THREE privately at runtime. Never commit the approved student's email or code.
# The code must be at least 32 random URL-safe characters, sent over a private channel.
# Possession of the code is not proof of email ownership or student status.
# The 1-person gate will refuse all other student signups and previous student sessions.
# PILOT_STUDENT_CAP=1
# PILOT_STUDENT_EMAIL=
# PILOT_STUDENT_INVITE_TOKEN=

# Week 6 interactive classes: PRIVATE server-only LiveKit settings.
# Without all three, class room tokens fail closed with HTTP 503.
# A signed token DOES NOT create/verify a real room or prove streaming.
# LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Class/service paid access requires a trusted server-owned Week 5 entitlement adapter.
# Never expose LiveKit secret, room service credentials or payment entitlement authorizers as NEXT_PUBLIC_.

# Week 6: optional outbound reminders. Reminders default to in-app only.
# A user must opt in and verify their account email before any outbound send.
# STUDENT_CREATORS_LEARNING_EMAIL_ENABLED=false
# RESEND_API_KEY=re_example_server_only
# STUDENT_CREATORS_NOTIFICATION_FROM=notifications@your-verified-domain.example

# Week 6: class/service checkout uses Week 5's TEST-mode payment gateway only.
# PAYSTACK_TEST_SECRET_KEY=sk_test_example_server_only
# Never map paystack_secret_key blindly: confirm prefix is sk_test_, NOT sk_live_.
# LIVEKIT_API_SECRET=your_dedicated_livekit_room_signing_secret
# In Vercel, lowercase livekit_apikey and livekit_project_url are recognized,
# but livekit_sip is NOT an API signing secret.
# Hosted W06 storage: proposed SQL migrations 0010 + 0011 require separate
# approved staging and must not be assumed active in the existing project.
