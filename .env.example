# Template only. These variables are NOT used until the full app is integrated.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=  # RESERVED: not used for live checkout or deployment
# PAYSTACK_ENVIRONMENT=test
# Optional local-only sandbox checkout: set a real Paystack sk_test key in the
# server's private runtime environment, NEVER in source or NEXT_PUBLIC_*.
# PAYSTACK_TEST_SECRET_KEY=
# Future timestamped Paystack-Signature webhook mode uses a separate whsec_
# signing secret plus whk_ key ID (not the sk_test API key).
# PAYSTACK_WEBHOOK_SIGNING_SECRET=
# PAYSTACK_WEBHOOK_KEY_ID=

# Student platform: server-only Supabase draft API (not connected yet).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use server-side legacy service-role JWT only; NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local-first: no online database or API keys required
APP_DATA_MODE=local
# Optional absolute local SQLite database path, shared by admin CLI and dev server.
# LOCAL_SQLITE_PATH=/your/private/path/campus.sqlite
# Bootstrap admin using secure terminal input: do not commit these secrets.
# LOCAL_ADMIN_EMAIL=
# LOCAL_ADMIN_PASSWORD=
# One-person alpha (local SQLite only, no public/serverless deployment).
# Set BOTH privately at runtime. The approved student's email must NEVER be committed.
# The 1-person gate will refuse all other student signups and previous student sessions.
# PILOT_STUDENT_CAP=1
# PILOT_STUDENT_EMAIL=
