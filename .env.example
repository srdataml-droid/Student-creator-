# Server configuration template only. Never commit real credentials.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=  # RESERVED: not used for live checkout or deployment
# PAYSTACK_ENVIRONMENT=test
# Founder-controlled live initialization remains OFF. Never put these in client code.
# PAYSTACK_LIVE_PAYMENTS_ENABLED=0
# Only explicit independent_web is supported for hosted Paystack initialization.
# STUDENT_CREATORS_DISTRIBUTION_CHANNEL=independent_web
# Optional local-only sandbox checkout: set a real Paystack sk_test key in the
# server's private runtime environment, NEVER in source or NEXT_PUBLIC_*.
# PAYSTACK_TEST_SECRET_KEY=
# Local nonproduction timestamped Paystack-Signature webhook uses a separate whsec_
# signing secret plus whk_ key ID (not the sk_test API key).
# PAYSTACK_WEBHOOK_SIGNING_SECRET=
# PAYSTACK_WEBHOOK_KEY_ID=
# Opt in only when running scripts/local-payment-reconcile.mjs against a disposable DB.
# LOCAL_PAYMENT_SANDBOX=1

# Student platform: server-only Supabase draft API (not connected yet).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use server-side legacy service-role JWT only; NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local-first: no online database or API keys required
APP_DATA_MODE=local
# Optional absolute local SQLite database path, shared by admin CLI and dev server.
# LOCAL_SQLITE_PATH=/your/private/path/campus.sqlite
# Bootstrap admin using secure terminal input: do not commit these secrets.
# LOCAL_ADMIN_EMAIL=
# LOCAL_ADMIN_PASSWORD=
# One-person alpha (local SQLite only, no public/serverless deployment).
# Set ALL THREE privately at runtime. Never commit the approved student's email or code.
# The code must be at least 32 random URL-safe characters, sent over a private channel.
# Possession of the code is not proof of email ownership or student status.
# The 1-person gate will refuse all other student signups and previous student sessions.
# PILOT_STUDENT_CAP=1
# PILOT_STUDENT_EMAIL=
# PILOT_STUDENT_INVITE_TOKEN=
